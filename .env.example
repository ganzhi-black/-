PORT=8787

# Admin dashboard access.
# Production must set this to your own login email, for example:
# ADMIN_EMAILS=your-email@example.com
# Keep DISABLE_ADMIN_AUTH empty/0 in production. Only use 1 for local dashboard previews.
ADMIN_EMAILS=
DISABLE_ADMIN_AUTH=0
USE_MEMORY_STORE=0
VITE_DASHBOARD_PREVIEW=0
# Use "none" when production frontend and backend are on different domains.
AUTH_COOKIE_SAMESITE=none

# Frontend/API domain settings.
# In production, leave VITE_API_BASE_URL empty so the browser calls the same domain:
# https://qimoshua.top/api -> frontend server proxy -> Railway API service.
VITE_API_BASE_URL=
# Optional: set this in the frontend deployment to bypass the frontend /api proxy for realtime speech.
# Example: wss://api-production-5b928.up.railway.app/api/audio/realtime
VITE_REALTIME_ASR_URL=
BACKEND_ORIGIN=https://api-production-5b928.up.railway.app
CORS_ORIGINS=https://qimoshua.top,https://www.qimoshua.top,https://qimoshua-ganzhi-blacks-projects.vercel.app,https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Add this when you are ready to call a real AI model API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Realtime speech-to-text with Alibaba Cloud Model Studio / DashScope.
ASR_PROVIDER=qwen
DASHSCOPE_API_KEY=
QWEN_ASR_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/inference
QWEN_ASR_MODEL=fun-asr-realtime
ASR_READY_TIMEOUT_MS=8000

# DeepSeek is supported for question generation.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_GRADE_TIMEOUT_MS=20000
DEEPSEEK_GRADE_MAX_TOKENS=900
GRADING_SOURCE_CHAR_LIMIT=1200
GRADING_ANSWER_CHAR_LIMIT=2500

# Embeddings. Use qwen for DashScope text-embedding-v4, or openai/local.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: if empty, Qwen embedding will reuse DASHSCOPE_API_KEY above.
QWEN_EMBEDDING_API_KEY=
QWEN_EMBEDDING_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIM=1536
QWEN_EMBEDDING_BATCH_SIZE=10
QWEN_EMBEDDING_CONCURRENCY=3
DOC_CHUNK_SIZE=800
CHUNK_INSERT_BATCH_SIZE=20
UPLOAD_MAX_MB=80
MARKITDOWN_TIMEOUT_MS=120000

# Optional: set to markitdown after installing the Python package.
# DOCUMENT_CONVERTER=markitdown
# PYTHON_BIN=python

# Add this when PostgreSQL + pgvector is ready.
# Example: postgresql://postgres:password@localhost:5432/qimoshua
# Railway production must set DATABASE_URL on the backend service,
# otherwise user/course/practice/dashboard data will not persist.
DATABASE_URL=
